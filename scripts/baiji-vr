#!/usr/bin/env bash
set -euo pipefail

BAIJI_ROOT="${BAIJI_ROOT:-$HOME/baiji}"
export DISPLAY="${BAIJI_DISPLAY:-${DISPLAY:-:2}}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XR_RUNTIME_JSON="${XR_RUNTIME_JSON:-/opt/steamvr/steamxr_linuxarm64.json}"
export LD_LIBRARY_PATH="$BAIJI_ROOT/lib/baiji"
export QT_PLUGIN_PATH="$BAIJI_ROOT/lib/baiji/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$BAIJI_ROOT/lib/baiji/plugins/platforms"
export QT_QPA_PLATFORM=xcb
# Window Scale (VR settings) sizes the Qt windows in Game Mode. A QT_SCALE_FACTOR set here (for example
# export QT_SCALE_FACTOR=1.25) is used instead of it.
unset WAYLAND_DISPLAY

for auth in /run/user/1000/nested_plasma/xauth_*; do
  if [[ -f "$auth" ]]; then
    export XAUTHORITY="$auth"
  fi
done

# The logs of the last runs are kept for a problem report: .old is the one before this, .old2 the one
# before that, up to .old8. Nothing here may keep the program from starting.
LOG_DIR="$HOME/.local/share/baiji/Logs"
mkdir -p "$LOG_DIR"
turn_over() {
  local log="$LOG_DIR/$1" i
  [[ -s "$log" ]] || return 0
  for i in 7 6 5 4 3 2; do
    if [[ -f "$log.old$i" ]]; then
      mv -f "$log.old$i" "$log.old$((i + 1))" 2>/dev/null || true
    fi
  done
  if [[ -f "$log.old" ]]; then
    mv -f "$log.old" "$log.old2" 2>/dev/null || true
  fi
  mv -f "$log" "$log.old" 2>/dev/null || true
}
turn_over baiji-launcher.log
turn_over dolphin.log

if [[ -f "$HOME/.config/baiji/debug-logging" ]]; then
  exec "$BAIJI_ROOT/bin/baiji" \
    -C Logger.Options.WriteToFile=True \
    -C Logger.Options.Verbosity=5 \
    -C Logger.Logs.Video=True \
    -C Logger.Logs.OpenXR=True \
    -C Logger.Logs.CI=True \
    "$@" >>"$LOG_DIR/baiji-launcher.log" 2>&1
fi

# Errors and warnings of the last run are always kept, so a game that fails leaves a trace.
exec "$BAIJI_ROOT/bin/baiji" \
  -C Logger.Options.WriteToConsole=True \
  -C Logger.Options.Verbosity=3 \
  -C Logger.Logs.Video=True \
  -C Logger.Logs.OpenXR=True \
  -C Logger.Logs.CORE=True \
  -C Logger.Logs.BOOT=True \
  "$@" >"$LOG_DIR/baiji-launcher.log" 2>&1
